#: [about]thanks
msgid "Thanks"
msgstr "Спасибо"

#: [about]developers
msgid "Developers"
msgstr "Разработчики"

#: [about]translators
msgid "Translators"
msgstr "Переводчики"

#: [about]translators_text
msgid "Thanks to all the translators"
msgstr "Спасибо всем переводчикам"

#: [about]software
msgid "Software"
msgstr "Программа"

#: [about]resources
msgid "Resources"
msgstr "Ресурсы"

#: [about]api
msgid "API"
msgstr "API"

#: [about]info
msgid "Movim is an XMPP-based communication platform. All the project, except the following software and resources, is under"
msgstr "Movim — основанная на XMPP платформа для коммуникаций. Весь проект, кроме следующих программ и ресурсов, находится под"

#: [about]sourcecode_title
msgid "Sourcecode"
msgstr "Исходный код"

#: [about]sourcecode_text
msgid "Checkout the sourcecode on the Github repository"
msgstr "Мы публикуем исходный код в Github-репозиторий"

#: [account]title [page]account
msgid "Account"
msgstr "Учётная запись"

#: [account]account_management
msgid "Account management"
msgstr "Управление учётной записью"

#: [account]password_change_title
msgid "Change my password"
msgstr "Сменить пароль"

#: [account]password [credentials]password [form]password [input]password
msgid "Password"
msgstr "Пароль"

#: [account]password_confirmation
msgid "Password confirmation"
msgstr "Пароль заново"

#: [account]password_changed
msgid "The password has been updated"
msgstr "Пароль был изменён"

#: [account]password_not_same
msgid "The provided passwords are not the same"
msgstr "Введённые пароли не совпадают"

#: [account]delete
msgid "Delete your account"
msgstr "Удалить свою учётную запись"

#: [account]delete_text
msgid "You will delete your XMPP account and all the relative information linked to it (profile, contacts, and publications)."
msgstr "Вы удалите свою учётную запись XMPP и всю связанную с ней информацию (профиль, контакты и публикации)."

#: [account]delete_text_confirm
msgid "Type your full username"
msgstr "Введите Ваше полное имя"

#: [account]delete_text_error
msgid "Please provide a valid username."
msgstr "Пожалуйста, введите действующую учётную запись."

#: [account]gateway_title
msgid "Gateways"
msgstr "Шлюзы"

#: [account]clear
msgid "Leave this instance"
msgstr "Покинуть этот сервер"

#: [account]clear_text
msgid "You will delete all the relative information linked to your account on this Movim instance (profile, contacts, and publications)."
msgstr "При этом будет удалена вся сопутствующая информация, связанная с вашей учётной записью на этом сервере Movim (профиль, контакты и публикации)."

#: [account]clear_text_confirm
msgid "This action will not delete your account but will disconnect you from Movim."
msgstr "Это действие не приведет к полному удалению вашей учётной записи, но отключит Вас от Movim."

#: [account]delete_bundle_title
msgid "OMEMO Key deletion"
msgstr "Удаление ключа OMEMO"

#: [account]delete_bundle_text
msgid "You are going to destroy the following OMEMO key. Your contacts will not be able to encrypt messages using that key anymore. This action cannot be reverted. Are you sure?"
msgstr "Вы собираетесь уничтожить данный ключ OMEMO. Ваши контакты больше не смогут шифровать сообщения с помощью этого ключа. Это действие необратимо. Вы уверены?"

#: [adhoc]title
msgid "Actions"
msgstr "Действия"

#: [adhoc]completed
msgid "Action completed"
msgstr "Действие выполнено"

#: [tools]title
msgid "Developer Tools"
msgstr "Инструменты разработчика"

#: [tools]sdp_to_jingle
msgid "Convert SDP to Jingle"
msgstr "Преобразовать SDP в Jingle"

#: [tools]sdp_title
msgid "SDP"
msgstr "SDP"

#: [tools]jingle_to_sdp
msgid "Convert Jingle to SDP"
msgstr "Преобразовать Jingle в SDP"

#: [tools]jingle_title
msgid "Jingle stanza"
msgstr "Строфа Jingle"

#: [admin]general
msgid "General Settings"
msgstr "Общие параметры"

#: [general]theme
msgid "Theme"
msgstr "Тема"

#: [general]language
msgid "Default language"
msgstr "Язык по умолчанию"

#: [general]log_verbosity
msgid "Log verbosity"
msgstr "Детализация лога"

#: [general]join_title
msgid "Your instance is public?"
msgstr "Ваш сервер общедоступен?"

#: [general]join_text
msgid "Register your instance on join.movim.eu and join the Movim federation!"
msgstr "Зарегистрируйте свой сервер на join.movim.eu и присоединяйтесь к федерации Movim!"

#: [restrictsuggestions]title
msgid "Restrict suggestions"
msgstr "Предотвращать подсказки"

#: [restrictsuggestions]text
msgid "Only suggest chatrooms, Communities, and other contents that are available on the user's XMPP server and related services"
msgstr "Предлагать только те чаты, сообщества и остальное, которые доступны на XMPP-сервере пользователя и связанных с ним сервисах."

#: [chatonly]title
msgid "Chat only"
msgstr "Только чат"

#: [chatonly]text
msgid "Disable all the social feature (Communities, Blog…) and keep only the chat ones"
msgstr "Отключить все социальные функции (сообщества, блог и т.д.) и оставить только чаты."

#: [credentials]title
msgid "Administration Credential"
msgstr "Управление учётными данными"

#: [credentials]username [input]username
msgid "Username"
msgstr "Имя пользователя"

#: [credentials]re_password
msgid "Retype password"
msgstr "Введите пароль ещё раз"

#: [disableregistration]title
msgid "Disable the XMPP registration feature"
msgstr "Отключить возможность регистрации по XMPP"

#: [disableregistration]text
msgid "Remove the XMPP registration flow and buttons from the interface"
msgstr "Удалите из интерфейса процесс регистрации по XMPP и соответствующие кнопки."

#: [whitelist]title
msgid "Allowed XMPP Servers"
msgstr "Позволеные XMPP серверы"

#: [whitelist]info1
msgid "If you want to specify a list of authorized XMPP servers on your Movim pod and forbid the connection on all the others please put their domain name(s) here, with comma (ex: movim.eu,jabber.fr)"
msgstr "Если вы хотите указать список авторизованных XMPP-серверов для вашего Movim-пода и запретить подключение ко всем остальным, пожалуйста, укажите здесь их доменные имена через запятую (например: movim.eu,jabber.fr)."

#: [whitelist]info2
msgid "Leave this field blank if you allow the access to all the XMPP accounts."
msgstr "Оставьте это поле пустым, если вы хотите позволить доступ ко всем XMPP аккаунтам."

#: [whitelist]label
msgid "List of allowed XMPP servers"
msgstr "Список позволеных XMPP серверов"

#: [information]title
msgctxt "[information]title"
msgid "Information Message"
msgstr "Информационное сообщение"

#: [information]description [communityconfig]description
msgid "Description"
msgstr "Описание"

#: [information]description_placeholder
msgid "General description of the instance"
msgstr "Общее описание этого сервера"

#: [information]banner
msgid "Main banner"
msgstr "Главный баннер"

#: [information]banner_info
msgid "Ensure that the picture is not too large and can be reached from any webpages"
msgstr "Убедитесь, что изображение не слишком большое и доступно с любой веб-страницы."

#: [information]info1
msgid "This message will be displayed on the login page. It can be used to link the Terms and Conditions of your Movim instance for example."
msgstr "Это сообщение будет отображаться на странице входа в систему. Его можно использовать, например, для ссылки на Условия использования вашего сервера Movim."

#: [information]info2
msgid "Leave this field blank if you don’t want to show any message."
msgstr "Если Вы не хотите показывать сообщения, оставьте это поле пустым. "

#: [information]label
msgctxt "[information]label"
msgid "Information Message"
msgstr "Информационное сообщение"

#: [xmpp]title
msgid "Default XMPP server"
msgstr "XMPP-сервер по умолчанию"

#: [xmpp]domain
msgid "Main XMPP server domain"
msgstr "Домен основного XMPP-сервера"

#: [xmpp]description
msgid "Main XMPP server description"
msgstr "Описание основного XMPP-сервера"

#: [xmpp]country
msgid "Main XMPP server country"
msgstr "Страна нахождения основного XMPP-сервера"

#: [xmpp]country_pick
msgid "Pick a country in the list"
msgstr "Выберите страну из списка"

#: [tenor]title
msgid "Tenor integration"
msgstr "Интеграция с Tenor"

#: [tenor]label
msgid "Your Tenor API Key"
msgstr "Ваш API ключ Тенора"

#: [tenor]info1
msgid "Movim integrates the Tenor API to allow GIF search and publication in Chat"
msgstr "Movim интегрируется с Tenor, чтобы искать и публиковать GIFки в чате."

#: [tenor]info2
msgid "Access Tenor and get your API key"
msgstr "Зайдите на Тенор и получите свой ключ API"

#: [log]empty
msgid "Empty"
msgstr "Пусто"

#: [log]syslog
msgid "Syslog"
msgstr "Syslog"

#: [log]syslog_files
msgid "Syslog and files"
msgstr "Syslog и файлы"

#: [maxsessions]title
msgid "Maximum of connected sessions"
msgstr ""

#: [maxsessions]info
msgid "Movim will forbid new users to connect when the limit is reached, set it to 0 to disable"
msgstr ""

#: [adminreported]reported_by
msgid "Reported by %s users"
msgstr "Был обжалован %sпользователями"

#: [adminreported]info
msgid "Those accounts were reported by some Movim users"
msgstr "На эти сообщения поступили жалобы от некоторых пользователей Movim."

#: [adminreported]info2
msgid "You can choose to block them for all the other users"
msgstr "Вы можете заблокировать их для всех остальных пользователей."

#: [adminsessions]title
msgid "Sessions"
msgstr "Сеансы"

#: [adminsessions]text
msgid "Currently connected users on the pod"
msgstr "Сейчас подключенных пользователей к этому серверу"

#: [avatar]file
msgid "File"
msgstr "Файл"

#: [avatar]updated
msgid "Profile Picture Updated"
msgstr "Аватарка обновлена"

#: [avatar]not_updated
msgid "Profile Picture Not Updated"
msgstr "Аватарка не обновлена"

#: [avatar]change
msgid "Change my profile picture"
msgstr "Сменить свою аватарку"

#: [avatar]too_big
msgid "Your picture is too big"
msgstr "Ваше фото слишком большое"

#: [avatar]missing
msgid "No avatar yet"
msgstr "Ещё нет фото"

#: [banner]change
msgid "Change my banner"
msgstr "Сменить свой баннер"

#: [banner]updated
msgid "Banner Updated"
msgstr "Баннер обновлён"

#: [banner]not_updated
msgid "Banner Not Updated"
msgstr "Баннер не обновлён"

#: [banner]missing
msgid "No banner yet"
msgstr "Пока без баннера"

#: [blocked]title
msgid "Blocked"
msgstr "Чёрный список"

#: [blocked]block_account
msgid "Block the account"
msgstr "Заблокировать этот профиль"

#: [blocked]unblock_account
msgid "Unblock the account"
msgstr "Разблокировать этот профиль"

#: [blocked]account_blocked
msgid "Account blocked"
msgstr "Профиль заблокирован"

#: [blocked]account_unblocked
msgid "Account unblocked"
msgstr "Профиль разблокирован"

#: [blocked]placeholder
msgid "You will find here the users you have blocked"
msgstr "Здесь вы найдете пользователей, которых вы заблокировали"

#: [blocked]info
msgid "The following users are blocked by Movim and cannot contact you anymore"
msgstr "Следующие пользователи заблокированы Movim и больше не могут с вами связаться."

#: [blocked]info2
msgid "The administrator is also aware of this list and can therefore block those users system wide"
msgstr "Администратор также осведомлён об этом списке и, следовательно, может заблокировать этих пользователей во всей системе."

#: [blog]title
msgid "%s’s blog"
msgstr "Блог %s"

#: [blog]private
msgid "This content is private, please login to see it"
msgstr "Этот контент приватный, пожалуйста авторизуйтесь, чтобы посмотреть его"

#: [message]published
msgid "Message Published"
msgstr "Сообщение опубликовано"

